# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-this-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=cargotrack
POSTGRES_USER=cargotrack
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Documents
DOCUMENTS_ROOT=/app/Adjuntos
DOCUMENT_MAX_SIZE_MB=1
DOCUMENT_ALLOWED_EXTENSIONS=pdf,png,bmp,jpg,jpeg
CARRIER_EXPIRY_ALERT_DAYS=30
ORDER_OVERDUE_DAYS=7
